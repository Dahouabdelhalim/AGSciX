  "@graph": [
    {
      "@id": "study:prefix_tuning_optimizing_continuous_prompts_for_generation_2021",
      "@type": "mls:Study",
      "mention": {
        "start_char_doc": 13,
        "end_char_doc": 72,
        "prefix": "## Page 1  # ",
        "suffix": "  **Xiang Lisa Li**   Stanford University   xlisali@stanford.edu  **Percy Liang*",
        "valueSource": "extracted"
      },
      "mls:title": {
        "value": "Prefix-Tuning: Optimizing Continuous Prompts for Generation",
        "start_char_doc": 13,
        "end_char_doc": 72,
        "prefix": "## Page 1  # ",
        "suffix": "  **Xiang Lisa Li**   Stanford University   xlisali@stanford.edu  **Percy Liang*",
        "valueSource": "extracted"
      },
      "mls:abstract": {
        "value": "Fine-tuning is the de facto way of leveraging large pretrained language models for downstream tasks. However, fine-tuning modifies all the language model parameters and therefore necessitates storing a full copy for each task. In this paper, we propose prefix-tuning, a lightweight alternative to fine-tuning for natural language generation tasks, which keeps language model parameters frozen and instead optimizes a sequence of *continuous task-specific* vectors, which we call the *prefix*. Prefix-tuning draws inspiration from prompting for language models, allowing subsequent tokens to attend to this prefix as if it were “virtual tokens”. We apply prefix-tuning to GPT-2 for table-to-text generation and to BART for summarization. We show that by modifying only 0.1% of the parameters, prefix-tuning obtains comparable performance in the full data setting, outperforms fine-tuning in low-data settings, and extrapolates better to examples with topics that are unseen during training.",
        "start_char_doc": 215,
        "end_char_doc": 1204,
        "prefix": "u  **Percy Liang**   Stanford University   pliang@cs.stanford.edu  ## Abstract  ",
        "suffix": "  ## 1 Introduction  Fine-tuning is the prevalent paradigm for using large pretr",
        "valueSource": "extracted"
      },
      "mls:issued": {
        "value": "August 1–6, 2021",
        "start_char_doc": 3618,
        "end_char_doc": 3634,
