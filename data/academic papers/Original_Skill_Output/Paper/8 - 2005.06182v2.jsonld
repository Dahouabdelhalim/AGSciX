  "@graph": [
    {
      "@id": "study:mlsolv_a_prediction_solvation_free_energies_pairwise_atomistic_interactions_2020",
      "@type": "mls:Study",
      "mention": {
        "start_char_doc": 11,
        "end_char_doc": 126,
        "prefix": "## Page 1  ",
        "suffix": "  Hyuntae Lim* and YounJoon Jung†  Department of Chemistry, Seoul National Unive",
        "valueSource": "extracted"
      },
      "mls:title": {
        "value": "MLSolv-A: A Novel Machine Learning-Based Prediction of Solvation Free Energies from Pairwise Atomistic Interactions",
        "start_char_doc": 11,
        "end_char_doc": 126,
        "prefix": "## Page 1  ",
        "suffix": "  Hyuntae Lim* and YounJoon Jung†  Department of Chemistry, Seoul National Unive",
        "valueSource": "extracted"
      },
      "mls:abstract": {
        "value": "Recent advances in machine learning and their applications have lead to the development of diverse structure-property relationship models for crucial chemical properties, and the solvation free energy is one of them. Here, we introduce a novel ML-based solvation model, which calculates the solvation energy from pairwise atomistic interactions. The novelty of the proposed model consists of a simple architecture: two encoding functions extract atomic feature vectors from the given chemical structure, while the inner product between two atomistic features calculates their interactions. The results on 6,493 experimental measurements achieve outstanding performance and transferability for enlarging training data due to its solvent-non-specific nature. Analysis of the interaction map shows there is a great potential that our model reproduces group contributions on the solvation energy, which makes us believe that the model not only provides the predicted target property but also gives us more detailed physicochemical insights.",
        "start_char_doc": 257,
        "end_char_doc": 1293,
        "prefix": "emistry, Seoul National University, Seoul 08826, Korea  July 3, 2020  Abstract  ",
        "suffix": "  *ht0620@snu.ac.kr †yjjung@snu.ac.kr  &lt;page_number&gt;1&lt;/page_number&gt; ",
        "valueSource": "extracted"
      },
