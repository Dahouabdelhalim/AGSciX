/ItalicAngle 0 def
/isFixedPitch false def
/UnderlinePosition -100 def
/UnderlineThickness 50 def
end readonly def
/Encoding 256 array
0 1 255 {1 index exch /.notdef put} for
dup 52 /four put
dup 103 /g put
dup 108 /l put
dup 111 /o put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 37 /percent put
dup 43 /plus put
dup 59 /semicolon put
dup 54 /six put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
