        "valueSource": "extracted"
      },
      "mls:description": {
        "value": "Pre-trained Distillation combines MLM+ pre-training, task-specific distillation from a fine-tuned BERT teacher, and optional fine-tuning to build compact models across GLUE and Amazon review tasks.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:objective": {
        "value": "explore the interaction between pre-training and distillation under two variables that have been under-studied: model size and properties of unlabeled task data",
        "start_char_doc": 1292,
        "end_char_doc": 1452,
        "prefix": "extensive experiments, we more generally",
        "suffix": ". One surprising observation is",
        "valueSource": "extracted"
      },
      "mls:hypothesis": {
        "value": "pre-training remains important in the context of smaller architectures, and fine-tuning pre-trained compact models can be competitive",
        "start_char_doc": 782,
        "end_char_doc": 915,
        "prefix": "paper, we first show that",
        "suffix": "to more elaborate methods proposed",
        "valueSource": "extracted"
      },
      "mls:methodology": {
        "value": "masked LM (MLM) pre-training, task-specific distillation, and optional fine-tuning",
        "start_char_doc": null,
