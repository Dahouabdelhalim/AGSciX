    {
      "@id": "exp:lilnetx_compression_sparsification_tradeoff_2022",
      "@type": "mls:Experiment",
      "mention": {
        "start_char_doc": 24281,
        "end_char_doc": 24292,
        "prefix": "or slice sparsity. # 4",
        "suffix": "**Datasets.** We consider three datasets",
        "valueSource": "extracted"
      },
      "mls:description": {
        "value": "LilNetX is evaluated on CIFAR-10, CIFAR-100, and ImageNet using VGG-16, ResNet, and MobileNet-V2 architectures for accuracy-rate-computation trade-offs.",
        "start_char_doc": null,
        "end_char_doc": null,
        "prefix": null,
        "suffix": null,
        "valueSource": "inferred"
      },
      "mls:objective": {
        "value": "jointly optimize the model parameters for accuracy, model size on the disk and computation",
        "start_char_doc": 2055,
        "end_char_doc": 2145,
        "prefix": "neural network training framework to",
        "suffix": ", on any given task.",
        "valueSource": "extracted"
      },
      "mls:hypothesis": {
        "value": "learning models with specified accuracy-rate-computation trade-off",
        "start_char_doc": 423,
        "end_char_doc": 489,
        "prefix": "for neural networks that enables",
        "suffix": ". Prior works approach these",
        "valueSource": "extracted"
      },
      "mls:methodology": {
        "value": "joint objective that allows for an accuracy-rate-computation trade-off",
        "start_char_doc": 12604,
