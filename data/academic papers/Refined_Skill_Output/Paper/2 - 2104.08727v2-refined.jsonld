    {
      "@id": "exp:gooaq_t5_open_question_answering_2021",
      "@type": "mls:Experiment",
      "mention": {
        "start_char_doc": 20515,
        "end_char_doc": 20536,
        "prefix": "for future work. ## 4",
        "suffix": "GOOAQ naturally forms a dataset",
        "valueSource": "extracted"
      },
      "mls:description": {
        "value": "We benchmarked two variants of a state-of-the-art self-contained text generation model (T5, without retrieval) on three different sub-tasks of GOOAQ: short, snippet, and collection response questions",
        "start_char_doc": 35658,
        "end_char_doc": 35857,
        "prefix": "of questions asked by users.",
        "suffix": ". Our analysis, using both",
        "valueSource": "extracted"
      },
      "mls:objective": {
        "value": "study inherent differences between models producing different answer types",
        "start_char_doc": 1087,
        "end_char_doc": 1161,
        "prefix": "We use this dataset to",
        "suffix": ", and observe interesting trends.",
        "valueSource": "extracted"
      },
      "mls:hypothesis": {
        "value": "GOOAQ is a valuable training resource, resulting in strong performance on the recent ELI5 long-answers dataset",
        "start_char_doc": 1601,
        "end_char_doc": 1711,
        "prefix": "pre-training. Moreover, we show that",
        "suffix": ". We release GOOAQ to",
        "valueSource": "extracted"
      },
      "mls:methodology": {
        "value": "Both models were trained for 20k steps on the training splits, dumping checkpoints every 2k steps (with 196,608 tokens per batch on v3-128 TPUs) with the default hyperparameters",
        "start_char_doc": 27464,
        "end_char_doc": 27641,
        "prefix": "and the largest model (‘11B’).",
        "suffix": ". We select the checkpoint",
        "valueSource": "extracted"
      },
